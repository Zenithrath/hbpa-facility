{
  "permissions": {
    "allow": [
      "Shell(powershell -Command gc testout.txt | select -last 40 2 >& 1)",
      "Shell(powershell -Command Get-Content testout.txt | Measure-Object -Line; (Get-Content testout.txt)[-40..-1] 2 >& 1)",
      "Shell(type testout.txt | more +$(powershell -Command \"(gc testout.txt).Count - 40\") 2>&1 | tail -15)",
      "Shell(powershell -Command (Get-Content testout.txt)[-30..-1] 2 >& 1)",
      "Shell(powershell -Command Get-Content testout.txt | Select-Object -Last 30 2 >& 1)",
      "Shell(node tests/backend.test.cjs 2 >& 1)",
      "Shell(findstr:*)",
      "powershell"
    ],
    "deny": [],
    "defaultMode": "default"
  }
}